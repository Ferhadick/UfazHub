# Copy to .env on the Oracle Cloud VM before starting production compose.

POSTGRES_DB=ufaz_hub
POSTGRES_USER=ufaz
POSTGRES_PASSWORD=change-me-strong-db-password

DATABASE_URL=postgresql+asyncpg://ufaz:change-me-strong-db-password@postgres:5432/ufaz_hub

# Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-64-char-hex-secret
IP_HASH_SALT=replace-with-another-random-salt

# Public site URL (no trailing slash). Use https once Caddy has a certificate.
FRONTEND_URL=https://your-domain.com
COOKIE_SECURE=true

# Browser calls the API through Caddy on the same domain.
NEXT_PUBLIC_API_BASE_URL=https://your-domain.com/api/v1

# Domain Caddy listens on. Use your domain, or the VM public IP for a quick test.
APP_DOMAIN=your-domain.com

# Optional: email for Let's Encrypt certificate notices.
CADDY_EMAIL=you@example.com
